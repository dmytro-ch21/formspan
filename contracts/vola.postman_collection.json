    {
      "name": "Progression",
      "item": [
        {
          "name": "What to load today, per exercise, from the caller's own history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/suggestions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "suggestions"
              ],
              "query": [
                {
                  "key": "exercise_ids",
                  "value": "back-squat,bench-press",
                  "disabled": false,
                  "description": "Comma-separated, max 100."
                },
                {
                  "key": "goal",
                  "value": "hypertrophy",
                  "disabled": false,
                  "description": "One of `general`, `powerlifting`, `hypertrophy`, `endurance`. Deliberately typed as a plain string rather than an enum, because an enum would make a request validator or generated client reject exactly the unrecognised values this endpoint promises to accept."
                }
              ],
              "variable": []
            },
            "description": "One request for a whole workout rather than one per exercise. Each answer reads the **working sets of the last few sessions** containing that exercise \u2014 warm-ups excluded, since progressing off a warm-up would recommend a weight nobody worked at.\nWhole sessions rather than a single top set, because the rule gates on the weakest working set and on whether a load has repeated across sessions; neither question can be answered from one row.\nScoped to the caller: this endpoint reads training history and returns only their own."
          }
        }
      ]
    },
    {
      "name": "Records",
      "item": [
        {
          "name": "Personal records the caller holds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records"
              ],
              "query": [
                {
                  "key": "exercise_ids",
                  "value": "back-squat,bench-press",
                  "disabled": false,
                  "description": "Comma-separated. Overrides `scope`. At most 100."
                },
                {
                  "key": "scope",
                  "value": "mine",
                  "disabled": false,
                  "description": "`all` returns every exercise the caller has actually trained, most-used first, capped at 200 \u2014 the desk view. Omitted, the API answers for their pinned shortlist, falling back to the exercises they train most so the view is never empty pending setup."
                }
              ],
              "variable": []
            },
            "description": "Derived from the log on every read rather than stored. A kept record has to be *retracted* when the set behind it is corrected or its session deleted \u2014 and a stale one means congratulating someone for a lift they never made. Computed, a record is by construction exactly what the log says.\n\nWhich kinds an exercise can hold follows from its `load_type`, so a plank never reports a weight and a run never reports reps. Warm-ups and sets never marked done never count."
          }
        },
