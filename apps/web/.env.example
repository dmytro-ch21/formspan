# Copy to .env.local for local dev (already gitignored).
# Railway sets this directly per-environment for staging/production.

# Where the web app fetches the API from.
# dev: http://localhost:8080
# staging: https://staging-api.yourdomain.com (placeholder, not registered yet)
# production: https://api.yourdomain.com (placeholder, not registered yet)
NEXT_PUBLIC_API_URL=http://localhost:8080

# From the Clerk dashboard's API Keys page (one Clerk application per
# environment — dev/staging/production each get their own pk_/sk_ pair).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
