# Copy to .env.local for local dev (already gitignored).
# Railway sets this directly per-environment for staging/production.

# Where the admin app fetches the API from — the /v1/admin/* endpoints
# back the User Lookup and User Detail screens.
# dev: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Same Clerk application as apps/web — the admin console reuses the
# customer Clerk instance rather than standing up a separate one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Comma-separated allowlist of Clerk user IDs permitted into /users.
# Must match the backend's own ADMIN_USER_IDS (backend/.env) — the backend
# independently enforces it on /v1/admin/*, this is the UI-side gate.
# Find your ID in the Clerk dashboard, or from GET /v1/me.
ADMIN_USER_IDS=user_your_clerk_user_id_here
