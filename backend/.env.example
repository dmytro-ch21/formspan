# Copy to .env and adjust for local dev if you don't want the defaults.
# Railway injects these directly per-environment (staging/production) —
# this file is just the reference list, not loaded automatically by the Go
# binary (no dotenv dependency; keep config as real env vars, 12-factor style).

# Port the API listens on.
# dev: 8080 (default if unset) · staging/production: set by Railway
PORT=8080

# Comma-separated origins allowed to call this API cross-origin (CORS).
# Only relevant to browser-based clients (apps/web, the Expo web preview) —
# native iOS/Android requests aren't subject to CORS at all.
# dev: http://localhost:3000 (apps/web), http://localhost:8081 (Expo web preview)
# staging: https://staging.yourdomain.com (placeholder, not registered yet)
# production: https://yourdomain.com (placeholder, not registered yet)
WEB_ORIGIN=http://localhost:3000,http://localhost:8081

# Clerk instance issuer URL — required, no default. Used to fetch the JWKS
# for verifying session tokens (no Clerk secret key needed for this; that's
# only for privileged Backend API calls we don't make yet). Find it by
# decoding your NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (base64 middle segment) or
# from the Clerk dashboard's API Keys page ("Frontend API URL").
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Postgres connection string.
# dev: matches docker-compose.yml (run `docker compose up -d` first)
# staging/production: Railway injects its own managed Postgres's DATABASE_URL
DATABASE_URL=postgres://vola:vola_dev_only@localhost:5432/vola?sslmode=disable

# Postgres connection string for the `*_test.go` integration tests. They
# skip silently when this is unset — which meant that for a long time they
# only ever really ran in CI, and `go test ./...` passing locally proved
# less than it appeared to. Point it at a *separate* database from
# DATABASE_URL so a test run can never touch your dev data:
#   docker compose exec postgres createdb -U vola vola_test
#   cd backend && DATABASE_URL=<the vola_test URL> go run ./cmd/migrate up
TEST_DATABASE_URL=postgres://vola:vola_dev_only@localhost:5432/vola_test?sslmode=disable

# Comma-separated Clerk user IDs (the JWT's `sub` claim) allowed to call
# admin-only endpoints (GET /v1/admin/*). Same convention apps/admin uses
# for its own frontend gate — one admin allowlist, not two. Empty/unset
# means nobody can reach admin endpoints (fails closed).
ADMIN_USER_IDS=user_your_clerk_user_id_here
