{
  "name": "vola",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:admin": "pnpm --filter admin build",
    "build:api": "cd backend && go build -o bin/ ./cmd/...",
    "build:web": "pnpm --filter web build",
    "check:brand-copies": "node scripts/check-brand-copies.mjs",
    "check:ci-detector": "python3 scripts/check-ci-checks.py --self-test",
    "check:evals": "python3 scripts/check-dictation-evals.py",
    "check:grip-parity": "python3 scripts/check-grip-parity.py",
    "check:icons": "node scripts/generate_icons.mjs --check",
    "check:palette": "node scripts/validate_palette.mjs",
    "check:pr-work": "python3 scripts/check-pr-has-work.py --self-test",
    "check:python": "python3 scripts/check-python-syntax.py",
    "check:rate-parity": "python3 scripts/check-rate-parity.py",
    "check:tasks": "python3 scripts/check-tasks-integrity.py",
    "check:telemetry-parity": "python3 scripts/check-telemetry-parity.py",
    "check:timeout-parity": "python3 scripts/check-timeout-parity.py",
    "check:verify-chain": "python3 scripts/check-verify-chain.py",
    "ci:checks": "python3 scripts/check-ci-checks.py",
    "dev:admin": "pnpm --filter admin dev",
    "dev:api": "cd backend && set -a && . ./.env && set +a && go run ./cmd/api",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "fmt:api": "cd backend && test -z \"$(gofmt -l .)\" || { gofmt -l .; exit 1; }",
    "lint:admin": "pnpm --filter admin lint",
    "lint:mobile": "pnpm --filter mobile lint",
    "lint:openapi": "redocly lint contracts/public.openapi.yaml --config .redocly.yaml",
    "lint:web": "pnpm --filter web lint",
    "routes:mobile": "node scripts/generate_route_types.mjs",
    "test:admin": "pnpm --filter admin test",
    "test:api": "cd backend && go test -p 1 -timeout 3m ./...",
    "test:mobile": "pnpm --filter mobile test",
    "test:web": "pnpm --filter web test",
    "typecheck:admin": "pnpm --filter admin exec tsc --noEmit",
    "typecheck:mobile": "pnpm run routes:mobile && pnpm --filter mobile exec tsc --noEmit",
    "typecheck:web": "pnpm --filter web exec tsc --noEmit",
    "verify": "pnpm run check:tasks && pnpm run check:verify-chain && pnpm run check:ci-detector && pnpm run check:pr-work && pnpm run check:palette && pnpm run check:icons && pnpm run check:python && pnpm run check:grip-parity && pnpm run check:rate-parity && pnpm run check:telemetry-parity && pnpm run check:timeout-parity && pnpm run check:evals && pnpm run fmt:api && pnpm run vet:api && pnpm run build:api && pnpm run lint:openapi && pnpm run lint:mobile && pnpm run test:mobile && pnpm run typecheck:mobile && pnpm run check:brand-copies && pnpm run lint:web && pnpm run typecheck:web && pnpm run test:web && pnpm run lint:admin && pnpm run typecheck:admin && pnpm run test:admin",
    "vet:api": "cd backend && go vet ./..."
  },
  "devDependencies": {
    "@redocly/cli": "^2.41.0"
  }
}
