{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@kingstinct/react-native-healthkit": "^14.1.0",
    "expo": "~57.0.11",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.6",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.14",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "promise": "^8.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-health-connect": "^4.1.3",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "expo-build-properties": "~57.0.12",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:android",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 NODE_OPTIONS=--dns-result-order=ipv4first expo run:ios",
    "ios:device": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 NODE_OPTIONS=--dns-result-order=ipv4first expo run:ios --device --configuration Release",
    "prebuild": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo prebuild --clean",
    "web": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --web",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:prod": "node scripts/validate-production-config.mjs --check && eas build --platform ios --profile production",
    "submit:ios": "node scripts/validate-production-config.mjs --check-submit && eas submit --platform ios --latest",
    "build:android": "eas build --platform android --profile development",
    "test": "TZ=America/Los_Angeles jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --max-warnings=50",
    "eas-build-pre-install": "node scripts/validate-production-config.mjs --build-hook"
  },
  "private": true
}
