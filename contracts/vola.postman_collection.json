    {
      "name": "History",
      "item": [
        {
          "name": "Training history rolled up per day, with period totals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "history"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{sevenDaysAgo}}",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "to",
                  "value": "{{today}}",
                  "disabled": false,
                  "description": "Inclusive of the day named. Range must be five years or less."
                },
                {
                  "key": "sport",
                  "value": "strength",
                  "disabled": false,
                  "description": "Narrows the totals *and* the comparison window, so BJJ is measured against BJJ. `sports` is always unfiltered."
                },
                {
                  "key": "tz",
                  "value": "Europe/Berlin",
                  "disabled": false,
                  "description": "IANA name deciding which calendar day a session belongs to. Training at 19:00 in New York is 23:00 UTC, so bucketing in UTC would file a Tuesday session under Wednesday."
                }
              ],
              "variable": []
            },
            "description": "The analytical surface behind the web history page: one entry per calendar day that had training, totals for the period, and the same totals for the window immediately before it so the numbers read as a direction rather than a quantity.\n\nAggregated server-side on purpose. The working-set rule (completed, non-warm-up) lives in one place, and a client summing a truncated listing would quietly report the wrong total once history outgrows the page size."
          }
        }
      ]
