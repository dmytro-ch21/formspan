# Copy to .env.local for local dev (gitignored). Expo inlines any
# EXPO_PUBLIC_* var at build/bundle time, same convention as Next.js's
# NEXT_PUBLIC_* in apps/web.

# Where the app fetches the API from.
# dev (iOS Simulator / Expo Go on same machine): http://localhost:8080
# dev (physical device on same Wi-Fi): http://<your-machine-LAN-IP>:8080
# staging: https://staging-api.yourdomain.com (placeholder, not registered yet)
# production: https://api.yourdomain.com (placeholder, not registered yet)
EXPO_PUBLIC_API_URL=http://localhost:8080
