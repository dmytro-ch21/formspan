# Copy to .env.local for local dev (gitignored). Expo inlines any
# EXPO_PUBLIC_* var at build/bundle time, same convention as Next.js's
# NEXT_PUBLIC_* in apps/web.

# Where the app fetches the API from.
# dev (iOS Simulator / Expo Go on same machine): http://localhost:8080
# dev (physical device on same Wi-Fi): http://<your-machine-LAN-IP>:8080
# staging: https://staging-api.yourdomain.com (placeholder, not registered yet)
# production: https://api.yourdomain.com (placeholder, not registered yet)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Same Clerk application as apps/web and apps/admin — one Clerk instance
# across every client. Publishable key only; the secret key never ships to
# a mobile client.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# --- EAS / TestFlight builds ---
#
# EXPO_PUBLIC_* vars are inlined at *bundle* time, so a TestFlight build gets
# whatever was set when EAS built it -- not what is in this file at runtime.
# EXPO_PUBLIC_API_URL is therefore set per-profile in eas.json (staging for
# `preview` and `production`), and must NOT be relied on from here for builds.
#
# The Clerk publishable key is deliberately *not* in eas.json: it stays out of
# git, same as every other key in this repo. Set it once on EAS instead:
#
#   eas env:create --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_test_... \
#     --environment preview --environment production --visibility plaintext
#
# It is a publishable key and ships in the client bundle either way, so the
# secrecy is not the point -- keeping one convention for where keys live is.

# Optional. Name of a Clerk JWT template to mint session tokens from.
#
# Unset, the app uses Clerk's default session token, which lives about 60
# seconds — so the app can only work for ~a minute without reaching Clerk.
# A template lets you set that lifetime in the Clerk dashboard, and the
# longer it is, the longer a workout survives a dead spot.
#
# No backend change is needed: the API verifies signature, issuer, expiry and
# `sub` only (internal/platform/auth/auth.go) — no azp, no audience.
#
# THE COST, stated because the lifetime is a trade-off and not a free win:
# the API performs no revocation check, so a token is good for its whole life
# no matter what happens to the session behind it. A longer lifetime means a
# stolen device, a remote sign-out or a ban keeps working for that long — and
# the app persists the token in the keychain, so it survives a restart too.
# Minutes-to-an-hour buys real offline tolerance; days does not buy
# proportionally more and widens that window a lot.
# EXPO_PUBLIC_CLERK_JWT_TEMPLATE=vola-mobile
