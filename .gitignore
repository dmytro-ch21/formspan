# Node
node_modules/
.next/
dist/
build/

# Go
backend/bin/
*.exe

# Env
.env
.env.local
.env.*.local
# Backups of the above. `.env.local.bak` does not match `.env.*.local`, so a
# copy made before editing an env file was landing in `git status` as an
# ordinary untracked file — carrying whatever keys the original held.
*.bak

# Secrets that have no business being in a repo at all.
#
# `secrets.txt` shows up in the root periodically containing a live API key. It
# was never gitignored, which meant a single `git add -A` would have published a
# credential to a public remote — and `git add -A` is exactly what "commit
# everything" reaches for. Ignored rather than merely remembered.
secrets.txt

# Worktrees created for parallel branches. These are whole checkouts of the
# repo; committing one nests the repository inside itself.
.claude/worktrees/

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Python bytecode. `scripts/` is run directly, never imported — except by a
# one-off `importlib` load during review, which is how a .pyc got committed
# once. Ignored so that cannot happen again.
__pycache__/
*.pyc

# Output of scripts/import-exercise-catalog.py, which is retired. Ignored
# because a `git add -A` committed one of these once: a second copy of a
# catalog that nothing reads and nothing keeps in step, in the very PR that
# deleted the last such file.
*.generated.json

# Rendered by scripts/generate_sounds.py. Only the sounds the app actually
# plays are checked in (apps/mobile/assets/sounds/*.m4a); the rest of the family
# is regenerable and would just be unused binaries in the history. Stated
# without a count on purpose — this said "four" one sound-wiring PR later.
assets/audio/
evals/bjj-dictation/pending/
