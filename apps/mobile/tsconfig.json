{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // The cheapest possible guard against the exact bug that shipped: a hook
    // imported and never called, next to a useState nothing ever updated, so
    // the "Track effort" setting silently did nothing.
    //
    // These predate this app having a linter, and they STAY authoritative now
    // that it does: `@typescript-eslint/no-unused-vars` also runs, but only as
    // a warning under the backlog rules in eslint.config.mjs, while these are
    // hard errors in `typecheck:mobile`. tsc wins, deliberately — an unused
    // local is the shape of a wire someone forgot to connect.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    // jest's globals (`describe`/`it`/`expect`/`jest`) and node's `Buffer`,
    // used only by lib/__tests__. Listed explicitly because setting `types`
    // at all opts out of TypeScript's "include every @types package"
    // default — so anything else needed here has to be named.
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
